<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="1040" viewBox="0 0 1600 1040">
  <defs>
    <style>
      .title{font:700 34px Arial,sans-serif;fill:#102a43}.subtitle{font:18px Arial,sans-serif;fill:#486581}.head{font:700 18px Arial,sans-serif;fill:#102a43}.label{font:600 16px Arial,sans-serif;fill:#102a43}.small{font:14px Arial,sans-serif;fill:#334e68}.tiny{font:12px Arial,sans-serif;fill:#486581}.box{stroke:#486581;stroke-width:2;rx:18;ry:18}.wire{fill:none;stroke-width:4;stroke-linecap:round;stroke-linejoin:round}.dot{stroke:#fff;stroke-width:2}.note{font:italic 13px Arial,sans-serif;fill:#627d98}
    </style>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L9,3 L0,6 Z" fill="#627d98"/></marker>
  </defs>
  <rect width="1600" height="1040" fill="#f7fbff"/>
  <rect x="0" y="0" width="1600" height="105" fill="#d9efff"/>
  <text x="800" y="47" text-anchor="middle" class="title">HeatShield AI — Arduino UNO Q Offline Heatwave Safety System</text>
  <text x="800" y="78" text-anchor="middle" class="subtitle">Concept circuit diagram • Sensors → Edge-AI decision → Alert and cooling action</text>

  <!-- UNO Q -->
  <rect x="620" y="300" width="360" height="430" class="box" fill="#1e5799" stroke="#0e3b70"/>
  <rect x="645" y="330" width="310" height="95" rx="14" fill="#74c0fc"/>
  <text x="800" y="367" text-anchor="middle" style="font:700 27px Arial;fill:#062a50">ARDUINO UNO Q</text>
  <text x="800" y="397" text-anchor="middle" class="small">Main controller + local Edge AI</text>
  <rect x="655" y="455" width="135" height="90" rx="10" fill="#e7f5ff"/>
  <text x="722" y="484" text-anchor="middle" class="label">MCU</text><text x="722" y="508" text-anchor="middle" class="tiny">Reads sensors</text><text x="722" y="527" text-anchor="middle" class="tiny">Controls outputs</text>
  <rect x="810" y="455" width="135" height="90" rx="10" fill="#e7f5ff"/>
  <text x="877" y="484" text-anchor="middle" class="label">Linux / AI</text><text x="877" y="508" text-anchor="middle" class="tiny">Calculates local</text><text x="877" y="527" text-anchor="middle" class="tiny">heat-risk score</text>
  <text x="650" y="590" class="tiny" fill="#fff">3.3V + GND → sensors</text>
  <text x="650" y="620" class="tiny" fill="#fff">I2C SDA/SCL → BME280, BH1750, OLED</text>
  <text x="650" y="650" class="tiny" fill="#fff">GPIO → buzzer, LED, MOSFET fan driver</text>
  <text x="650" y="687" class="note" fill="#fff">No cloud needed: readings and AI stay on the board.</text>

  <!-- Sensors -->
  <text x="255" y="145" text-anchor="middle" class="head">SENSORS — collect real-world data</text>
  <rect x="70" y="185" width="335" height="145" class="box" fill="#d3f9d8"/>
  <text x="237" y="220" text-anchor="middle" class="label">BME280</text>
  <text x="237" y="247" text-anchor="middle" class="small">Temperature + Humidity sensor</text>
  <text x="237" y="276" text-anchor="middle" class="tiny">Use: measures heat and moisture in room</text>
  <text x="237" y="300" text-anchor="middle" class="tiny">Connect: 3.3V, GND, SDA, SCL (I2C)</text>
  <rect x="70" y="380" width="335" height="145" class="box" fill="#fff3bf"/>
  <text x="237" y="415" text-anchor="middle" class="label">BH1750</text>
  <text x="237" y="442" text-anchor="middle" class="small">Light / Lux sensor</text>
  <text x="237" y="471" text-anchor="middle" class="tiny">Use: detects sunlight / heat gain near windows</text>
  <text x="237" y="495" text-anchor="middle" class="tiny">Connect: 3.3V, GND, SDA, SCL (I2C)</text>
  <rect x="70" y="575" width="335" height="145" class="box" fill="#e9ecef"/>
  <text x="237" y="610" text-anchor="middle" class="label">AM312 PIR (optional)</text>
  <text x="237" y="637" text-anchor="middle" class="small">Motion / occupancy sensor</text>
  <text x="237" y="666" text-anchor="middle" class="tiny">Use: cooling only when a person is present</text>
  <text x="237" y="690" text-anchor="middle" class="tiny">Connect: 3.3V, GND, GPIO input</text>

  <!-- outputs -->
  <text x="1325" y="145" text-anchor="middle" class="head">OUTPUTS — alert and protect the user</text>
  <rect x="1190" y="185" width="335" height="145" class="box" fill="#e7f5ff"/>
  <text x="1357" y="220" text-anchor="middle" class="label">OLED display (SSD1306)</text>
  <text x="1357" y="247" text-anchor="middle" class="small">128 × 64 I2C screen</text>
  <text x="1357" y="276" text-anchor="middle" class="tiny">Use: shows readings, risk and alert reason</text>
  <text x="1357" y="300" text-anchor="middle" class="tiny">Connect: 3.3V, GND, SDA, SCL (I2C)</text>
  <rect x="1190" y="380" width="335" height="145" class="box" fill="#ffe3e3"/>
  <text x="1357" y="415" text-anchor="middle" class="label">Buzzer + RGB LED</text>
  <text x="1357" y="442" text-anchor="middle" class="small">Audible and visual alert</text>
  <text x="1357" y="471" text-anchor="middle" class="tiny">Use: red/danger, yellow/caution, green/safe</text>
  <text x="1357" y="495" text-anchor="middle" class="tiny">Connect: GPIO outputs; LED needs 220 Ω resistors</text>
  <rect x="1190" y="575" width="335" height="145" class="box" fill="#ffd8a8"/>
  <text x="1357" y="610" text-anchor="middle" class="label">MOSFET driver + 5V fan</text>
  <text x="1357" y="637" text-anchor="middle" class="small">Automatic cooling action</text>
  <text x="1357" y="666" text-anchor="middle" class="tiny">Use: fan turns ON at high heat-risk</text>
  <text x="1357" y="690" text-anchor="middle" class="tiny">GPIO → MOSFET; fan uses separate 5V supply</text>

  <!-- Data lines -->
  <path d="M405 257 H550 V480 H620" class="wire" stroke="#228be6"/><circle cx="550" cy="480" r="7" class="dot" fill="#228be6"/>
  <text x="465" y="245" class="tiny" fill="#1971c2">I2C: SDA + SCL</text>
  <path d="M405 452 H530 V500 H620" class="wire" stroke="#228be6"/><circle cx="530" cy="500" r="7" class="dot" fill="#228be6"/>
  <path d="M405 647 H570 V650 H620" class="wire" stroke="#6741d9"/><circle cx="570" cy="650" r="7" class="dot" fill="#6741d9"/>
  <text x="475" y="637" class="tiny" fill="#5f3dc4">GPIO input</text>
  <path d="M980 480 H1080 V257 H1190" class="wire" stroke="#228be6"/><circle cx="1080" cy="480" r="7" class="dot" fill="#228be6"/>
  <text x="1040" y="245" class="tiny" fill="#1971c2">I2C: SDA + SCL</text>
  <path d="M980 550 H1060 V452 H1190" class="wire" stroke="#e03131"/><circle cx="1060" cy="550" r="7" class="dot" fill="#e03131"/>
  <text x="1040" y="540" class="tiny" fill="#c92a2a">GPIO outputs</text>
  <path d="M980 650 H1090 V647 H1190" class="wire" stroke="#f08c00"/><circle cx="1090" cy="650" r="7" class="dot" fill="#f08c00"/>
  <text x="1030" y="640" class="tiny" fill="#d9480f">GPIO control</text>

  <!-- AI flow -->
  <rect x="390" y="805" width="820" height="130" class="box" fill="#eef2ff" stroke="#5f3dc4"/>
  <text x="800" y="842" text-anchor="middle" class="head">UNO Q local Edge-AI decision (works without internet)</text>
  <text x="800" y="875" text-anchor="middle" class="small">Temperature + Humidity + Lux + Occupancy + Time → Heat Risk: SAFE / CAUTION / DANGER</text>
  <text x="800" y="907" text-anchor="middle" class="small">DANGER example: display message + buzzer + red LED + fan ON</text>
  <path d="M800 730 V795" class="wire" stroke="#627d98" marker-end="url(#arrow)"/>
  <text x="818" y="770" class="tiny">data analysis</text>

  <!-- Power note -->
  <rect x="75" y="775" width="255" height="175" class="box" fill="#fff" stroke="#e67700"/>
  <text x="202" y="812" text-anchor="middle" class="head">POWER NOTE</text>
  <text x="202" y="842" text-anchor="middle" class="small">UNO Q: USB-C power</text>
  <text x="202" y="870" text-anchor="middle" class="small">Sensors: UNO Q 3.3V</text>
  <text x="202" y="898" text-anchor="middle" class="small">Fan: separate 5V supply</text>
  <text x="202" y="927" text-anchor="middle" class="tiny">Keep fan and UNO Q ground common.</text>
  <rect x="1270" y="775" width="255" height="175" class="box" fill="#fff" stroke="#e03131"/>
  <text x="1397" y="812" text-anchor="middle" class="head">SAFETY NOTE</text>
  <text x="1397" y="844" text-anchor="middle" class="small">Use only low-voltage</text>
  <text x="1397" y="871" text-anchor="middle" class="small">5V DC fan/pump.</text>
  <text x="1397" y="905" text-anchor="middle" class="tiny">Do not connect 230V AC devices</text>
  <text x="1397" y="925" text-anchor="middle" class="tiny">directly to the prototype.</text>
</svg>
